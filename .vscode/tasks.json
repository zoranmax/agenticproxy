{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$esbuild-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build extension",
			"type": "shell",
			"command": "npm run build",
			"group": "build"
		},
		{
			"label": "Compile extension",
			"type": "shell",
			"command": "npm run compile",
			"group": "build"
		},
		{
			"label": "Typecheck",
			"type": "shell",
			"command": "npm run typecheck",
			"group": "build"
		}
	]
}